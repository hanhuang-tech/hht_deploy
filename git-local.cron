00 01 * * * echo $(date) && cd /home/han/hht/ && /bin/git fetch origin && /bin/git reset --hard origin/master >> /home/han/cron.log 2>&1
01 01 * * * echo $(date) && bash /home/han/hht_deploy/sed.sh >> /home/han/cron.log 2>&1
01 05 * * * echo $(date) && truncate -s 100 /var/lib/docker/containers/*/*-json.log >> /home/han/cron.log 2>&1
00 00 01 * * echo $(date) && docker exec -it hht_deploy-web-1 certbot renew >> /home/han/cron.log 2>&1
01 00 01 * * echo $(date) && docker exec -it hht_deploy-web-1 nginx -s reload >> /home/han/cron.log 2>&1
